name: ilan-botu

on:
  schedule:
    - cron: "0 * * * *"   # her saat başı (UTC; saat başı olduğu için Türkiye'de de saat başı)
  workflow_dispatch:       # elle çalıştırmak için

permissions:
  contents: write

concurrency:
  group: ilan-botu
  cancel-in-progress: false

jobs:
  kontrol:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Paketleri kur
        run: |
          pip install playwright requests
          playwright install --with-deps chromium

      - name: İlanları kontrol et
        run: python bot.py
        env:
          TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}

      - name: Hata ayıklama dosyaları
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: debug
          path: debug/
          if-no-files-found: ignore

      - name: Durumu kaydet
        run: |
          git config user.name "ilan-botu"
          git config user.email "ilan-botu@users.noreply.github.com"
          git add seen.json
          git diff --cached --quiet || (git commit -m "ilan durumu güncellendi" && git push)
